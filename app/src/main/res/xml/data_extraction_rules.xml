<?xml version="1.0" encoding="utf-8"?>
<!--
  F-06: device tokens must be absent from cloud backup and device transfer.
  allowBackup=false already covers this; these rules make the intent explicit
  and survive someone flipping that flag back on without thinking.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
